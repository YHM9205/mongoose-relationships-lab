<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Categories</title>
</head>
<body>
    <h1>All Categories</h1>
    <a href="/categories/new">Add New Category</a>
    <ul>
        <% categories.forEach(cat => { %>
            <li><%= cat.categoryName %></li>
        <% }) %>
    </ul>
    <a href="/">Home</a>
</body>
</html>