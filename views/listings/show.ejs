<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>listing Title</title>
</head>
<body>
    <h1><%= listing.title %></h1>
    <p><strong>Description:</strong><%= listing.discription %></p>
    <p><strong>Address:</strong><%= listing.streetAddress %>, <%= listing.city %></p>
    <p><strong>Price:</strong><%= listing.price %></p>
    <p><strong>Type:</strong><%= listing.propertyType%></p>
    <p><strong>Size:</strong><%= listing.size %>sq mt</p>
    <p><strong>Owner:</strong><%= listing.owner ? listing.owner.username : 'Unknown' %></p>
    <p><strong>Category:</strong><%= listing.category ? listing.category.categoryName :'None' %></p>
    <p><strong>Available:</strong><%= listing.isAvailable? 'Yes' : 'No' %></p>


    <h3>Add a Review</h3>
    <form action="/listings/<%= listing._id %>/reviews" method="POST">
        <lable>Review Title:</lable>
        <input type="text" name="reviewTitle" required>
       
        <lable>Review Body:</lable>
        <textarea type="text" name="reviewBody" required></textarea>
       
        <lable>Rating (1-5):</lable>
        <input type="Number" name="rating" min="1" max="5" required>


        <label for="creator">Creator ID (User ID):</label>
        <input type="text" name="creator" placeholder="Paste User ObjectId here" required>

        <button type="submit">Submit Review</button>
    </form>

    <br>
    <a href="/listings/">Back to Listing</a>
    
</body>
</html>