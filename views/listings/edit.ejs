<!DOCTYPE html>
<html>
<head>
  <title>Edit Listing</title>
</head>
<body>
  <h1>Edit Listing</h1>
  <form action="/listings/<%= listing._id %>?_method=PUT" method="POST">
    <label>Title:</label>
    <input name="title" value="<%= listing.title %>" required />

    <label>Description:</label>
    <textarea name="description" required><%= listing.description %></textarea>

    <label>Street Address:</label>
    <input name="streetAddress" value="<%= listing.streetAddress %>" required />

    <label>City:</label>
    <input name="city" value="<%= listing.city %>" required />

    <label>Price:</label>
    <input name="price" type="number" value="<%= listing.price %>" required />

    <label>Size:</label>
    <input name="size" type="number" value="<%= listing.size %>" required />

    <label>Category:</label>
    <select name="category" required>
      <% categories.forEach(cat => { %>
        <option value="<%= cat._id %>" <%= cat._id.toString() === listing.category.toString() ? 'selected' : '' %>>
          <%= cat.categoryName %>
        </option>
      <% }) %>
    </select>

    <button type="submit">Update Listing</button>
  </form>
  <br>
  <a href="/listings/<%= listing._id %>">Cancel</a>
</body>
</html>