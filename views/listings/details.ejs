<!DOCTYPE html>
<html>
<head>
  <title>Listing Details</title>
</head>
<body>
  <h1><%= listing details </h1>
  <p><strong>Description:</strong> <%= listing.description %></p>
  <p><strong>Street:</strong> <%= listing.streetAddress %></p>
  <p><strong>City:</strong> <%= listing.city %></p>
  <p><strong>Price:</strong> $<%= listing.price %></p>
  <p><strong>Size:</strong> <%= listing.size %> sqft</p>
  <p><strong>Category:</strong> <%= listing.category ? listing.category.categoryName : 'N/A' %></p>
  
  <br>
  <a href="/listings/<%= listing._id %>/edit">Edit Listing</a>
  
  <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="display:inline;">
    <button type="submit" onclick="return confirm('Are you sure?')">Delete Listing</button>
  </form>
  
  <br><br>
  <a href="/listings">Back to Listings</a>
</body>
</html>